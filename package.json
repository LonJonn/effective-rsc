{
  "name": "effective-rsc-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "site",
    "examples/*",
    "fixtures/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "docs:check": "bun scripts/generate-docs.ts --check",
    "docs:generate": "bun scripts/generate-docs.ts",
    "lint": "oxlint --deny-warnings --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt . '!vendor/**'",
    "fmt:check": "oxfmt --check . '!vendor/**'",
    "release": "bash scripts/release.sh",
    "release:promote-docs": "bash scripts/promote-docs.sh",
    "check": "bun run lint && bun run fmt:check && bun run docs:check",
    "test": "turbo test test:e2e",
    "test:e2e": "turbo test:e2e",
    "test:watch": "turbo test:watch",
    "vendor:sync": "bun scripts/sync-vendor.ts",
    "prepare": "effect-tsgo patch --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@playwright/test": "catalog:",
    "@types/bun": "catalog:",
    "oxfmt": "^0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.11.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "packageManager": "bun@1.4.1",
  "catalog": {
    "@base-ui/react": "^1.8.0",
    "@effect/atom-react": "4.0.0-rc.116",
    "@effect/platform-browser": "4.0.0-rc.116",
    "@effect/platform-bun": "4.0.0-rc.116",
    "@effect/sql-sqlite-bun": "4.0.0-rc.116",
    "@effect/vitest": "4.0.0-rc.116",
    "@playwright/test": "1.63.0",
    "@rslib/core": "1.0.0",
    "@types/bun": "~1.4.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "effect": "4.0.0-rc.116",
    "lucide-react": "^1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-rspack": "0.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"
  }
}
